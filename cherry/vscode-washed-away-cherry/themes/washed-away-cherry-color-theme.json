{
  "$schema": "vscode://schemas/color-theme",
  "name": "Washed Away Cherry",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#EFD0D8",
    "editor.foreground": "#8E163E",
    "editor.lineHighlightBackground": "#F6E1E6",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#F08BAA80",
    "editor.selectionForeground": "#4C1327",
    "editor.inactiveSelectionBackground": "#F08BAA4D",
    "editor.selectionHighlightBackground": "#F08BAA33",
    "editor.wordHighlightBackground": "#F08BAA33",
    "editor.wordHighlightStrongBackground": "#A9C0CC66",
    "editor.findMatchBackground": "#F08BAA99",
    "editor.findMatchHighlightBackground": "#F08BAA4D",
    "editorLineNumber.foreground": "#B7798A",
    "editorLineNumber.activeForeground": "#A82143",
    "editorCursor.foreground": "#4C1327",
    "editorBracketMatch.background": "#F6E1E6",
    "editorBracketMatch.border": "#6F8F52",
    "editorIndentGuide.background1": "#E4BBC5",
    "editorIndentGuide.activeBackground1": "#D49BAB",
    "editorWhitespace.foreground": "#D8AAB6",
    "editorRuler.foreground": "#D8AAB6",
    "editorGutter.addedBackground": "#6F8F52",
    "editorGutter.modifiedBackground": "#6D8FA2",
    "editorGutter.deletedBackground": "#A82143",
    "editorError.foreground": "#A82143",
    "editorWarning.foreground": "#986174",
    "editorInfo.foreground": "#6D8FA2",
    "activityBar.background": "#4C1327",
    "activityBar.foreground": "#F8F2F3",
    "activityBar.inactiveForeground": "#D7A5B4",
    "activityBarBadge.background": "#F08BAA",
    "activityBarBadge.foreground": "#4C1327",
    "sideBar.background": "#F6E1E6",
    "sideBar.foreground": "#4C1327",
    "sideBarSectionHeader.background": "#EFD0D8",
    "sideBarTitle.foreground": "#8E163E",
    "statusBar.background": "#4C1327",
    "statusBar.foreground": "#F8F2F3",
    "statusBar.noFolderBackground": "#7F1737",
    "statusBar.debuggingBackground": "#6F8F52",
    "statusBar.debuggingForeground": "#F8F2F3",
    "titleBar.activeBackground": "#7F1737",
    "titleBar.activeForeground": "#F8F2F3",
    "titleBar.inactiveBackground": "#986174",
    "titleBar.inactiveForeground": "#F8F2F3",
    "tab.activeBackground": "#EFD0D8",
    "tab.activeForeground": "#4C1327",
    "tab.activeBorderTop": "#A82143",
    "tab.inactiveBackground": "#F6E1E6",
    "tab.inactiveForeground": "#986174",
    "tab.border": "#E4BBC5",
    "editorGroupHeader.tabsBackground": "#F6E1E6",
    "panel.background": "#F6E1E6",
    "panel.border": "#D49BAB",
    "terminal.background": "#EFD0D8",
    "terminal.foreground": "#4C1327",
    "terminal.ansiBlack": "#4C1327",
    "terminal.ansiRed": "#A82143",
    "terminal.ansiGreen": "#6F8F52",
    "terminal.ansiYellow": "#986174",
    "terminal.ansiBlue": "#6D8FA2",
    "terminal.ansiMagenta": "#8E163E",
    "terminal.ansiCyan": "#6D8FA2",
    "terminal.ansiWhite": "#F8F2F3",
    "terminal.ansiBrightBlack": "#C2B2AD",
    "terminal.ansiBrightRed": "#A82143",
    "terminal.ansiBrightGreen": "#6F8F52",
    "terminal.ansiBrightYellow": "#F08BAA",
    "terminal.ansiBrightBlue": "#A9C0CC",
    "terminal.ansiBrightMagenta": "#7F1737",
    "terminal.ansiBrightCyan": "#A9C0CC",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "list.activeSelectionBackground": "#F08BAA80",
    "list.activeSelectionForeground": "#4C1327",
    "list.inactiveSelectionBackground": "#F08BAA4D",
    "list.hoverBackground": "#F08BAA33",
    "list.highlightForeground": "#A82143",
    "input.background": "#F8F2F3",
    "input.border": "#D49BAB",
    "focusBorder": "#A82143",
    "dropdown.background": "#F8F2F3",
    "button.background": "#8E163E",
    "button.foreground": "#F8F2F3",
    "button.hoverBackground": "#A82143",
    "badge.background": "#6D8FA2",
    "badge.foreground": "#F8F2F3",
    "progressBar.background": "#A82143",
    "scrollbarSlider.background": "#9861744D",
    "scrollbarSlider.hoverBackground": "#98617480",
    "scrollbarSlider.activeBackground": "#8E163E80",
    "peekViewEditor.background": "#F6E1E6",
    "peekViewResult.background": "#F8F2F3",
    "widget.border": "#D49BAB",
    "editorWidget.background": "#F8F2F3",
    "editorSuggestWidget.selectedBackground": "#F08BAA4D",
    "editorHoverWidget.background": "#F8F2F3"
  },
  "tokenColors": [
    {
      "name": "All code — bold",
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#C2B2AD", "fontStyle": "bold" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.other", "variable.parameter", "variable.other.member", "meta.definition.variable", "entity.other.attribute-name"],
      "settings": { "foreground": "#6D8FA2", "fontStyle": "bold" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "entity.name.function.member", "support.function", "meta.function-call"],
      "settings": { "foreground": "#6F8F52", "fontStyle": "bold" }
    },
    {
      "name": "Core cherry syntax",
      "scope": ["keyword", "storage", "string", "constant", "entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.tag", "support.type", "support.class", "meta.preprocessor", "punctuation.definition.directive"],
      "settings": { "foreground": "#8E163E", "fontStyle": "bold" }
    },
    {
      "name": "Quiet operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#7F1737", "fontStyle": "bold" }
    },
    {
      "name": "Macros, special values, and escapes",
      "scope": ["entity.name.function.preprocessor", "entity.name.function.macro", "meta.preprocessor.macro", "entity.name.type.parameter", "constant.character.escape", "invalid", "invalid.illegal"],
      "settings": { "foreground": "#A82143", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "variable": { "foreground": "#6D8FA2", "fontStyle": "bold" },
    "parameter": { "foreground": "#6D8FA2", "fontStyle": "bold" },
    "property": { "foreground": "#6D8FA2", "fontStyle": "bold" },
    "function": { "foreground": "#6F8F52", "fontStyle": "bold" },
    "method": { "foreground": "#6F8F52", "fontStyle": "bold" },
    "comment": { "foreground": "#C2B2AD", "fontStyle": "bold" },
    "class": { "foreground": "#8E163E", "fontStyle": "bold" },
    "struct": { "foreground": "#8E163E", "fontStyle": "bold" },
    "namespace": { "foreground": "#8E163E", "fontStyle": "bold" },
    "type": { "foreground": "#8E163E", "fontStyle": "bold" },
    "type.builtin": { "foreground": "#8E163E", "fontStyle": "bold" },
    "typeParameter": { "foreground": "#A82143", "fontStyle": "bold" },
    "interface": { "foreground": "#8E163E", "fontStyle": "bold" },
    "enum": { "foreground": "#8E163E", "fontStyle": "bold" },
    "enumMember": { "foreground": "#8E163E", "fontStyle": "bold" },
    "macro": { "foreground": "#A82143", "fontStyle": "bold" },
    "keyword": { "foreground": "#8E163E", "fontStyle": "bold" },
    "string": { "foreground": "#8E163E", "fontStyle": "bold" },
    "number": { "foreground": "#8E163E", "fontStyle": "bold" }
  }
}
